const FONT_NOTE := "All interface text uses Godot Engine's built-in default font; its licence is listed in the Godot Engine third-party notices at the end of this page. The project bundles no other font."
const ORIGINS_NOTE := "An unofficial fan remake inspired by ZolarKeth's 2009 Roblox game Keth Shipyards. No original Roblox assets or scripts are bundled."
const ORIGINAL_WORK_NOTE := "All geometry, UI, effects and audio in the game are original project work. No original Roblox assets or scripts are bundled."


static func project_version() -> String:
	var version := str(ProjectSettings.get_setting("application/config/version", "")).strip_edges()
	return version if not version.is_empty() else "unknown"


## Footer line: game title, project version and, when known, the build stamp the
## pause menu already shows.
static func version_footer(build_display_text: String = "") -> String:
	var footer := "%s  //  VERSION %s" % [GAME_TITLE, project_version()]
	var build := build_display_text.strip_edges()
	if not build.is_empty():
		footer += "  //  %s" % build
	return footer


static func godot_version_text() -> String:
	var info := Engine.get_version_info()
	return "Godot Engine %s" % str(info.get("string", "%s.%s" % [
		str(info.get("major", 4)), str(info.get("minor", 0)),
	]))


## Godot's own MIT licence text, which the licence requires in the credits.
static func godot_license_text() -> String:
	return Engine.get_license_text().strip_edges()


## One entry per third-party component bundled inside the engine binary, as
## Engine.get_copyright_info() reports it: component name, copyright holders
## and the licence identifier.
static func engine_component_notices() -> Array[String]:
	var notices: Array[String] = []
	for raw_component: Variant in Engine.get_copyright_info():
		if not raw_component is Dictionary:
			continue
		var component := raw_component as Dictionary
		var lines: PackedStringArray = [str(component.get("name", "Component"))]
		for raw_part: Variant in component.get("parts", []):
			if not raw_part is Dictionary:
				continue
			var part := raw_part as Dictionary
			for holder: Variant in part.get("copyright", []):
				lines.append("  (c) %s" % str(holder))
			lines.append("  Licence: %s" % str(part.get("license", "")))
		notices.append("\n".join(lines))
	return notices


## The full text of every licence the engine components above refer to.
static func engine_license_texts() -> Array[String]:
	var texts: Array[String] = []
	var licenses := Engine.get_license_info()
	var names := licenses.keys()
	names.sort()
	for license_name: Variant in names:
		texts.append("%s\n\n%s" % [str(license_name), str(licenses[license_name]).strip_edges()])
	return texts


## The primary sections, in display order. The engine notices are a separate,
## collapsible section built on demand by the page.
static func sections() -> Array[Dictionary]:
	var asset_lines: Array[Dictionary] = []
	for entry: Dictionary in ASSET_ENTRIES:
		asset_lines.append({
			"heading": "%s  —  %s" % [str(entry.kind).to_upper(), str(entry.register)],
			"body": "%s\n%s" % [str(entry.credit), str(entry.licence)],
		})
	var tool_lines: Array[Dictionary] = []
	for tool: Dictionary in TOOL_CREDITS:
		tool_lines.append({"heading": str(tool.name), "body": str(tool.detail)})
	return [
		{
			"id": &"game",
			"title": GAME_TITLE,
			"entries": [
				{"heading": "Developed by", "body": "%s\n%s" % [TEAM_NAME, REPOSITORY]},
				{"heading": "Origins", "body": ORIGINS_NOTE},
			],
		},
		{
			"id": &"engine",
			"title": "ENGINE AND TOOLS",
			"entries": tool_lines,
		},
		{
			"id": &"godot_license",
			"title": "GODOT ENGINE LICENCE",
			"entries": [
				{"heading": godot_version_text(), "body": godot_license_text()},
			],
		},
		{
			"id": &"fonts",
			"title": "FONTS",
			"entries": [{"heading": "Interface font", "body": FONT_NOTE}],
		},
		{
			"id": &"assets",
			"title": "ASSET ATTRIBUTIONS AND LICENCES",
			"entries": asset_lines + [{"heading": "Original work", "body": ORIGINAL_WORK_NOTE}],
		},
	]


## Every registered ASSETS.md heading, for the page and its regression test.
static func asset_registers() -> PackedStringArray:
	var registers := PackedStringArray()
	for entry: Dictionary in ASSET_ENTRIES:
		registers.append(str(entry.register))
	return registers
