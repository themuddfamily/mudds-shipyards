const REQUIRED_PLUME_NAMES := [
	"PortEnginePlume",
	"StarboardEnginePlume",
	"LOD1PortEnginePlume",
	"LOD1StarboardEnginePlume",
]

const CONTENT_NOTE := (
	"B7 frames 373-467 securely link a wide pale delta/arrow craft to the "
	+ "Zenith-class Interceptor label in footage uploaded in 2012. The recording "
	+ "date and build revision are unknown. A5 says Interceptor while A9 says "
	+ "Fighter. Only the B7-observed broad visual language is source-bounded here; "
	+ "the single-pilot runtime, dimensions, canopy, cockpit, engines, plumes, "
	+ "weapons, collision, damage, audio, docking, materials and all handling are "
	+ "modern interpretation. No historical handling claim is made."
)

var _zenith_built := false
var _zenith_visual: Node3D
var _authored_presentation: Node3D
var _functional_cockpit: Node3D
var _functional_canopy: Node3D
var _engine_plumes: Array[MeshInstance3D] = []
var _plume_base_scales: Dictionary = {}
var _close_plume_batch: MultiMeshInstance3D
var _close_plume_sources: Array[MeshInstance3D] = []
var _identity_snapshot: Dictionary = {}


func _uses_torrent_reconstruction_presentation() -> bool:
	return false


func _ready() -> void:
	super._ready()
	if not _zenith_built:
		_zenith_built = rebuild_variant_presentation(_build_zenith_variant)
	if _zenith_built:
		_zenith_built = _reconfigure_component_damage_from_final_root_collision()
	_apply_zenith_metadata()
	_sync_zenith_canopy_immediately()
	_sync_zenith_engine_presentation_immediately()


func _physics_process(delta: float) -> void:
	super._physics_process(delta)
	if _reset_for_reuse_mutation_blocked():
		return
	_update_zenith_engine_presentation(delta)


func get_zenith_visual_root() -> Node3D:
	return _zenith_visual if _zenith_visual != null and is_instance_valid(_zenith_visual) else null


func get_zenith_authored_presentation() -> Node3D:
	return _authored_presentation if _authored_presentation != null and is_instance_valid(_authored_presentation) else null


func get_zenith_engine_plumes() -> Array[MeshInstance3D]:
	var result: Array[MeshInstance3D] = []
	for plume in _engine_plumes:
		if is_instance_valid(plume):
			result.append(plume)
	return result


func get_zenith_evidence_report() -> Dictionary:
	var definition := get_ship_definition()
	return {
		"schema_version": SCHEMA_VERSION,
		"evidence_status": EVIDENCE_STATUS,
		"evidence_scope": EVIDENCE_SCOPE,
		"source_ids": PackedStringArray(["A5", "A9", "B7"]),
		"source_anchors": PackedStringArray([
			"B7@00:33.909/f373 craft appears after empty berth",
			"B7@00:33.909-00:42.455/f373-f467 continuous approach, boarding and flight",
		]),
		"creator_label_conflict": &"A5_interceptor_A9_fighter",
		"authenticated_historical_geometry": false,
		"historical_handling_claim": false,
		"implemented_pilot_capacity": PILOT_CAPACITY,
		"content_note": CONTENT_NOTE,
		"ship_definition": definition.get_audit_report() if definition != null else {},
	}.duplicate(true)


func update_zenith_lod_for_distance(distance_metres: float) -> void:
	if not is_inside_tree() or is_queued_for_deletion():
		return
	if _authored_presentation != null \
		and _authored_presentation.has_method("update_lod_for_distance"):
		_authored_presentation.call("update_lod_for_distance", distance_metres)


func get_zenith_active_lod() -> int:
	if _authored_presentation != null \
		and _authored_presentation.has_method("get_active_lod"):
		return int(_authored_presentation.call("get_active_lod"))
	return -1


func get_zenith_runtime_identity_report() -> Dictionary:
	var current := _capture_runtime_identities()
	return {
		"schema_version": SCHEMA_VERSION,
		"stable": not _identity_snapshot.is_empty() and current == _identity_snapshot,
		"baseline": _identity_snapshot.duplicate(true),
		"current": current.duplicate(true),
	}.duplicate(true)


func get_zenith_collision_contract_report() -> Dictionary:
	var violations: Array[Dictionary] = []
	_audit_collision_authority(violations)
	var error_codes := PackedStringArray()
	var errors := PackedStringArray()
	for record in violations:
		error_codes.append(str(record.get("code", &"unknown")))
		errors.append(str(record.get("message", "unknown collision audit failure")))
	var live_shapes: Array[Dictionary] = []
	var oracle_summaries: Array[Dictionary] = []
	var ordered_names := PackedStringArray()
	var live_type_counts := {}
	for spec in COLLISION_SPECS:
		var collision := get_node_or_null(NodePath(str(spec.get("name", &"")))) as CollisionShape3D
		var shape := collision.shape if collision != null else null
		var shape_type := StringName(shape.get_class()) if shape != null else &""
		ordered_names.append(str(spec.get("name", &"")))
		live_type_counts[shape_type] = int(live_type_counts.get(shape_type, 0)) + 1
		var live_record := {
			"name": collision.name if collision != null else &"",
			"shape_type": shape_type,
			"position": collision.position if collision != null else Vector3.INF,
			"rotation_degrees": collision.rotation_degrees if collision != null else Vector3.INF,
			"basis": collision.basis if collision != null else Basis(),
			"enabled": collision != null and not collision.disabled,
			"top_level": collision.top_level if collision != null else true,
			"node_instance_id": collision.get_instance_id() if collision != null else 0,
			"shape_resource_id": shape.get_instance_id() if shape != null else 0,
		}
		if shape is ConvexPolygonShape3D:
			var points := (shape as ConvexPolygonShape3D).points
			live_record["point_count"] = points.size()
			live_record["points_sha256"] = _convex_points_digest(points, spec.get("points", []))
		elif shape is CylinderShape3D:
			live_record["radius"] = (shape as CylinderShape3D).radius
			live_record["height"] = (shape as CylinderShape3D).height
		elif shape is BoxShape3D:
			live_record["size"] = (shape as BoxShape3D).size
		live_shapes.append(live_record)
		oracle_summaries.append(_collision_spec_summary(spec))
	return {
		"schema_version": SCHEMA_VERSION,
		"valid": violations.is_empty(),
		"errors": errors,
		"error_codes": error_codes,
		"violations": violations.duplicate(true),
		"oracle_id": COLLISION_ORACLE_ID,
		"geometry_sha256": COLLISION_GEOMETRY_SHA256,
		"authority": &"runtime_hard_coded",
		"manifest_loaded_for_authority": false,
		"imported_collision_authority": false,
		"shape_count": COLLISION_SPECS.size(),
		"shape_type_counts": live_type_counts.duplicate(true),
		"expected_shape_type_counts": COLLISION_TYPE_COUNTS.duplicate(true),
		"ordered_names": ordered_names,
		"oracle": oracle_summaries,
		"live_shapes": live_shapes,
		"landing": get_landing_collision_report().duplicate(true),
	}.duplicate(true)


func get_zenith_audit_report() -> Dictionary:
	var violations: Array[Dictionary] = []
	var definition := get_ship_definition()
	if not _zenith_built:
		_violation(violations, &"runtime_build_missing", "runtime", "Zenith replacement did not commit")
	if get_ship_id() != EXPECTED_SHIP_ID:
		_violation(violations, &"ship_identity_drift", "ship_id", "runtime ship ID drifted")
	if get_home_berth_id() != EXPECTED_HOME_BERTH_ID:
		_violation(violations, &"home_berth_drift", "home_berth_id", "home berth ID drifted")
	if definition == null or not definition.is_definition_valid():
		_violation(violations, &"definition_invalid", "ship_definition", "Zenith definition is absent or invalid")
	else:
		if definition.resource_path != DEFINITION_PATH:
			_violation(violations, &"definition_resource_drift", "ship_definition", "definition resource path drifted")
		if definition.get_ship_id() != EXPECTED_SHIP_ID:
			_violation(violations, &"definition_identity_drift", "ship_definition.ship_id", "definition ship ID drifted")
		if definition.get_evidence_status_id() != &"provisional" or definition.is_authenticated():
			_violation(violations, &"definition_evidence_drift", "ship_definition.evidence_status", "definition must remain provisional")
		if definition.audio_profile_id != EXPECTED_AUDIO_PROFILE_ID:
			_violation(violations, &"audio_profile_drift", "ship_definition.audio_profile_id", "audio profile must remain declared standard fighter")
		if not "No historical handling claim" in definition.evidence_notes:
			_violation(violations, &"historical_handling_claim_drift", "ship_definition.evidence_notes", "handling limitation is missing")

	if _zenith_visual == null or not is_instance_valid(_zenith_visual) \
		or _zenith_visual.get_parent() != self or _zenith_visual.name != "ZenithVisual":
		_violation(violations, &"visual_root_identity_drift", "ZenithVisual", "runtime visual root identity or parent drifted")
	else:
		if not _zenith_visual.position.is_equal_approx(Vector3.ZERO) \
			or not _zenith_visual.scale.is_equal_approx(Vector3.ONE) \
			or not is_zero_approx(_zenith_visual.rotation.x) \
			or not is_zero_approx(_zenith_visual.rotation.y) \
			or absf(_zenith_visual.rotation.z) > deg_to_rad(visual_bank_degrees) + 0.01:
			_violation(violations, &"visual_root_transform_drift", "ZenithVisual", "visual root exceeded its bank-only transform contract")
	if get_node_or_null("TorrentVisual") != null:
		_violation(violations, &"legacy_visual_present", "TorrentVisual", "inherited Torrent visual root remains installed")

	var authored_audit := _get_authored_audit()
	if _authored_presentation == null or not is_instance_valid(_authored_presentation) \
		or _authored_presentation.get_parent() != _zenith_visual:
		_violation(violations, &"presentation_identity_drift", "ZenithVisual/ZenithAuthoredPresentation", "authored presentation identity or parent drifted")
	elif not _authored_presentation.transform.is_equal_approx(Transform3D.IDENTITY):
		_violation(violations, &"presentation_transform_drift", "ZenithVisual/ZenithAuthoredPresentation", "authored presentation must remain identity-mounted")
	if not bool(authored_audit.get("valid", false)):
		_violation(violations, &"authored_asset_red", "ZenithAuthoredPresentation", ";".join(authored_audit.get("errors", PackedStringArray()) as PackedStringArray))
	_audit_authored_contract(authored_audit, violations)
	_audit_functional_authority(violations)
	_audit_collision_authority(violations)
	_audit_runtime_identities(violations)

	var error_codes := PackedStringArray()
	var errors := PackedStringArray()
	for record in violations:
		error_codes.append(str(record.get("code", &"unknown")))
		errors.append(str(record.get("message", "unknown Zenith audit failure")))
	return {
		"schema_version": SCHEMA_VERSION,
		"valid": violations.is_empty(),
		"errors": errors,
		"error_codes": error_codes,
		"violations": violations.duplicate(true),
		"ship_id": get_ship_id(),
		"home_berth_id": get_home_berth_id(),
		"pilot_capacity": PILOT_CAPACITY,
		"evidence": get_zenith_evidence_report(),
		"authored_asset": authored_audit.duplicate(true),
		"collision": get_zenith_collision_contract_report(),
		"runtime_identities": get_zenith_runtime_identity_report(),
	}.duplicate(true)


