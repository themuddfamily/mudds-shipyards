func _build_zenith_variant(_controller: HeroShip) -> bool:
	var inherited_visual := get_variant_visual_root()
	if inherited_visual == null:
		return false
	var cockpit := inherited_visual.get_node_or_null("CockpitInterior") as Node3D
	var canopy := inherited_visual.get_node_or_null("CanopyHinge") as Node3D
	var pilot_seat := cockpit.get_node_or_null("PilotSeatAnchor") as Marker3D if cockpit != null else null
	var boarding_entry := cockpit.get_node_or_null("BoardingEntry") as Marker3D if cockpit != null else null
	var cockpit_camera := cockpit.get_node_or_null("CockpitCamera") as Camera3D if cockpit != null else null
	if cockpit == null or canopy == null or pilot_seat == null \
		or boarding_entry == null or cockpit_camera == null:
		return false
	for required_path in ["BoardingPoint", "ExitPoint", "LeftMuzzle", "RightMuzzle"]:
		if not get_node_or_null(NodePath(required_path)) is Marker3D:
			return false
	if not get_node_or_null("ShipBoardingArea") is ShipBoardingArea \
		or get_damage_presentation() == null or get_ship_audio_rig() == null:
		return false

	# Stage and fully audit the authored package before the inherited controller
	# hierarchy, markers or collision authority are changed.
	var packed := load(PRESENTATION_PATH) as PackedScene
	if packed == null:
		return false
	var presentation := packed.instantiate() as Node3D
	if presentation == null:
		return false
	var staged_visual := Node3D.new()
	staged_visual.name = "ZenithVisual"
	staged_visual.set_meta("presentation_only_import", true)
	staged_visual.set_meta("gameplay_authority_owned_by_parent", true)
	add_child(staged_visual)
	staged_visual.add_child(presentation)
	presentation.transform = Transform3D.IDENTITY
	if not _preflight_authored_presentation(presentation):
		remove_child(staged_visual)
		staged_visual.queue_free()
		return false

	var staged_collisions: Array[CollisionShape3D] = []
	for spec in COLLISION_SPECS:
		var collision := _make_collision(spec)
		if collision == null:
			remove_child(staged_visual)
			staged_visual.queue_free()
			return false
		staged_collisions.append(collision)

	# The shared replacement setter is the last fallible seam. Call it before any
	# inherited node, marker or collider is mutated, so a rejection leaves the
	# original HeroShip hierarchy completely intact.
	if not replace_variant_visual_root(staged_visual):
		remove_child(staged_visual)
		staged_visual.queue_free()
		return false

	# Commit begins here. Every fallible external-resource, semantic and shared-
	# controller check has failed closed; only deterministic node moves remain.
	_zenith_visual = staged_visual
	_authored_presentation = presentation
	_functional_cockpit = cockpit
	_functional_canopy = canopy
	cockpit.reparent(staged_visual, false)
	canopy.reparent(staged_visual, false)
	_prune_inherited_cockpit_visuals(cockpit, pilot_seat, boarding_entry, cockpit_camera)
	_prune_all_children(canopy)
	cockpit.transform = Transform3D.IDENTITY
	canopy.position = Vector3.ZERO
	canopy.scale = Vector3.ONE
	pilot_seat.position = EXPECTED_ANCHORS[&"PilotSeatAnchor"]
	boarding_entry.position = EXPECTED_ANCHORS[&"BoardingEntry"]
	boarding_entry.rotation = Vector3(0.0, -PI * 0.5, 0.0)
	cockpit_camera.position = EXPECTED_ANCHORS[&"CockpitCamera"]
	cockpit_camera.rotation = Vector3.ZERO

	_apply_runtime_marker_contract()
	var inherited_collisions: Array[CollisionShape3D] = []
	for child in get_children():
		if child is CollisionShape3D:
			inherited_collisions.append(child as CollisionShape3D)
	for collision in inherited_collisions:
		remove_child(collision)
	for collision in staged_collisions:
		add_child(collision)

	_collect_engine_plumes()
	_install_close_plume_batch()
	for collision in inherited_collisions:
		collision.queue_free()
	if inherited_visual.get_parent() != null:
		inherited_visual.get_parent().remove_child(inherited_visual)
	inherited_visual.queue_free()
	_identity_snapshot = _capture_runtime_identities()
	return true


func _preflight_authored_presentation(presentation: Node3D) -> bool:
	for method_name in [
		"get_asset_audit_report", "get_asset_root", "get_source_core_root",
		"get_modern_systems_root", "get_lod0_roots", "get_lod1_roots",
		"get_canopy_pivot", "set_canopy_fraction", "get_semantic_anchor",
		"get_engine_plumes", "update_lod_for_distance", "get_active_lod",
	]:
		if not presentation.has_method(method_name):
			return false
	var audit := presentation.call("get_asset_audit_report") as Dictionary
	if not bool(audit.get("valid", false)) \
		or StringName(audit.get("asset_id", &"")) != AUTHORED_ASSET_ID \
		or StringName(audit.get("evidence_scope", &"")) != EVIDENCE_SCOPE \
		or not bool(audit.get("presentation_only", false)) \
		or bool(audit.get("gameplay_authority", true)) \
		or bool(audit.get("collision_authority", true)):
		return false
	if not (presentation.call("get_asset_root") is Node3D) \
		or not (presentation.call("get_source_core_root") is Node3D) \
		or not (presentation.call("get_modern_systems_root") is Node3D) \
		or not (presentation.call("get_canopy_pivot") is Node3D):
		return false
	for anchor_name: StringName in EXPECTED_ANCHORS:
		var anchor := presentation.call("get_semantic_anchor", anchor_name) as Node3D
		if anchor == null or anchor.position.distance_to(EXPECTED_ANCHORS[anchor_name]) > 0.002:
			return false
	var plume_names := PackedStringArray()
	var plume_value: Variant = presentation.call("get_engine_plumes")
	if not plume_value is Array:
		return false
	for candidate in plume_value:
		if not candidate is MeshInstance3D:
			return false
		plume_names.append(str((candidate as MeshInstance3D).name))
	plume_names.sort()
	var expected_names := PackedStringArray(REQUIRED_PLUME_NAMES)
	expected_names.sort()
	return plume_names == expected_names


func _make_collision(spec: Dictionary) -> CollisionShape3D:
	var position_value := spec.get("position", Vector3.INF) as Vector3
	var rotation_value := spec.get("rotation_degrees", Vector3.ZERO) as Vector3
	if not position_value.is_finite() or not rotation_value.is_finite():
		return null
	var collision := CollisionShape3D.new()
	collision.name = StringName(spec.get("name", &"ZenithCollision"))
	collision.position = position_value
	collision.rotation_degrees = rotation_value
	var shape_type := StringName(spec.get("shape_type", &""))
	if shape_type == &"ConvexPolygonShape3D":
		var points := _packed_points(spec.get("points", []))
		if points.size() < 4:
			return null
		var convex := ConvexPolygonShape3D.new()
		convex.points = points
		collision.shape = convex
	elif shape_type == &"CylinderShape3D":
		var radius := float(spec.get("radius", 0.0))
		var height := float(spec.get("height", 0.0))
		if not is_finite(radius) or not is_finite(height) or radius <= 0.0 or height <= 0.0:
			return null
		var cylinder := CylinderShape3D.new()
		cylinder.radius = radius
		cylinder.height = height
		collision.shape = cylinder
	elif shape_type == &"BoxShape3D":
		var size := spec.get("size", Vector3.ZERO) as Vector3
		if not size.is_finite() or size.x <= 0.0 or size.y <= 0.0 or size.z <= 0.0:
			return null
		var box := BoxShape3D.new()
		box.size = size
		collision.shape = box
	else:
		return null
	return collision


static func _packed_points(value: Variant) -> PackedVector3Array:
	var result := PackedVector3Array()
	if not value is Array:
		return result
	for point_value in value as Array:
		if not point_value is Vector3 or not (point_value as Vector3).is_finite():
			return PackedVector3Array()
		result.append(point_value as Vector3)
	return result


static func _convex_points_digest(points: PackedVector3Array, canonical_points: Variant) -> String:
	var json_points: Array[Array] = []
	var canonical := canonical_points as Array if canonical_points is Array else []
	for index in points.size():
		var point := points[index]
		var sign_witness := canonical[index] as Vector3 if index < canonical.size() else point
		json_points.append([
			sign_witness.x if is_zero_approx(point.x) and is_zero_approx(sign_witness.x) else snappedf(point.x, 0.000001),
			sign_witness.y if is_zero_approx(point.y) and is_zero_approx(sign_witness.y) else snappedf(point.y, 0.000001),
			sign_witness.z if is_zero_approx(point.z) and is_zero_approx(sign_witness.z) else snappedf(point.z, 0.000001),
		])
	return JSON.stringify(json_points, "", false, false).sha256_text()


static func _collision_spec_summary(spec: Dictionary) -> Dictionary:
	var summary := {
		"name": spec.get("name", &""),
		"shape_type": spec.get("shape_type", &""),
		"position": spec.get("position", Vector3.INF),
		"rotation_degrees": spec.get("rotation_degrees", Vector3.INF),
	}
	var shape_type := StringName(spec.get("shape_type", &""))
	if shape_type == &"ConvexPolygonShape3D":
		summary["point_count"] = (spec.get("points", []) as Array).size()
		summary["manifest_points_sha256"] = spec.get("points_sha256", "")
		summary["runtime_points_sha256"] = spec.get(
			"runtime_points_sha256", spec.get("points_sha256", "")
		)
	elif shape_type == &"CylinderShape3D":
		summary["radius"] = spec.get("radius", 0.0)
		summary["height"] = spec.get("height", 0.0)
	elif shape_type == &"BoxShape3D":
		summary["size"] = spec.get("size", Vector3.ZERO)
	return summary


func _prune_inherited_cockpit_visuals(
	cockpit: Node3D,
	pilot_seat: Marker3D,
	boarding_entry: Marker3D,
	cockpit_camera: Camera3D
) -> void:
	for child in cockpit.get_children():
		if child in [pilot_seat, boarding_entry, cockpit_camera]:
			continue
		cockpit.remove_child(child)
		child.queue_free()


func _prune_all_children(parent: Node) -> void:
	for child in parent.get_children():
		parent.remove_child(child)
		child.queue_free()


func _apply_runtime_marker_contract() -> void:
	var boarding := get_node_or_null("BoardingPoint") as Marker3D
	var exit := get_node_or_null("ExitPoint") as Marker3D
	var left_muzzle := get_node_or_null("LeftMuzzle") as Marker3D
	var right_muzzle := get_node_or_null("RightMuzzle") as Marker3D
	var docking_receiver := get_node_or_null("DockingReceiver") as Marker3D
	if docking_receiver == null:
		docking_receiver = Marker3D.new()
		docking_receiver.name = "DockingReceiver"
		add_child(docking_receiver)
	if boarding != null:
		boarding.position = EXPECTED_ANCHORS[&"BoardingPoint"]
		boarding.rotation = Vector3.ZERO
	if exit != null:
		exit.position = EXPECTED_ANCHORS[&"ExitPoint"]
		exit.rotation = Vector3(0.0, -PI * 0.5, 0.0)
	if left_muzzle != null:
		left_muzzle.position = EXPECTED_ANCHORS[&"LeftMuzzle"]
		left_muzzle.rotation = Vector3.ZERO
	if right_muzzle != null:
		right_muzzle.position = EXPECTED_ANCHORS[&"RightMuzzle"]
		right_muzzle.rotation = Vector3.ZERO
	docking_receiver.position = EXPECTED_ANCHORS[&"DockingReceiver"]
	docking_receiver.rotation = Vector3.ZERO
	var boarding_area := get_node_or_null("ShipBoardingArea") as Area3D
	if boarding_area != null:
		boarding_area.position = EXPECTED_ANCHORS[&"BoardingPoint"] + Vector3.UP * 0.5


func _collect_engine_plumes() -> void:
	_engine_plumes.clear()
	_plume_base_scales.clear()
	if _authored_presentation == null:
		return
	var result: Variant = _authored_presentation.call("get_engine_plumes")
	if not result is Array:
		return
	for candidate in result:
		if candidate is MeshInstance3D:
			var plume := candidate as MeshInstance3D
			_engine_plumes.append(plume)
			_plume_base_scales[plume.get_instance_id()] = plume.scale


## The imported static families are already joined. The first remaining safe
## repeated renderer family is the pair of modern close-LOD exhaust plumes.
## Keep both protected authored nodes alive as the semantic/dynamic authority,
## but render their exact transforms through one bounded MultiMesh submission.
func _install_close_plume_batch() -> void:
	_close_plume_batch = null
	_close_plume_sources.clear()
	var port: MeshInstance3D = null
	var starboard: MeshInstance3D = null
	for plume in _engine_plumes:
		if plume.name == &"PortEnginePlume":
			port = plume
		elif plume.name == &"StarboardEnginePlume":
			starboard = plume
	if (
		port == null or starboard == null
		or port.get_parent() != starboard.get_parent()
		or not port.get_parent() is Node3D
		or port.mesh == null or starboard.mesh == null
		or not _meshes_render_identically(
			port.mesh, starboard.mesh, port.material_override
		)
		or port.material_override != starboard.material_override
		or port.material_overlay != starboard.material_overlay
		or port.cast_shadow != starboard.cast_shadow
		or port.layers != starboard.layers
		or not is_equal_approx(port.extra_cull_margin, starboard.extra_cull_margin)
		or not is_equal_approx(port.lod_bias, starboard.lod_bias)
		or port.ignore_occlusion_culling != starboard.ignore_occlusion_culling
		or port.gi_mode != starboard.gi_mode
		or not is_equal_approx(port.transparency, starboard.transparency)
		or port.visibility_range_begin != starboard.visibility_range_begin
		or port.visibility_range_end != starboard.visibility_range_end
		or port.visibility_range_begin_margin != starboard.visibility_range_begin_margin
		or port.visibility_range_end_margin != starboard.visibility_range_end_margin
		or port.visibility_range_fade_mode != starboard.visibility_range_fade_mode
	):
		return

	var multi := MultiMesh.new()
	multi.transform_format = MultiMesh.TRANSFORM_3D
	multi.mesh = port.mesh
	multi.instance_count = 2
	multi.visible_instance_count = -1
	multi.set_instance_transform(0, port.transform)
	multi.set_instance_transform(1, starboard.transform)

	var batch := MultiMeshInstance3D.new()
	batch.name = "CloseEnginePlumeBatch"
	batch.multimesh = multi
	batch.material_override = port.material_override
	batch.material_overlay = port.material_overlay
	batch.cast_shadow = port.cast_shadow
	batch.layers = port.layers
	batch.extra_cull_margin = port.extra_cull_margin
	batch.lod_bias = port.lod_bias
	batch.ignore_occlusion_culling = port.ignore_occlusion_culling
	batch.gi_mode = port.gi_mode
	batch.transparency = port.transparency
	batch.visibility_range_begin = port.visibility_range_begin
	batch.visibility_range_end = port.visibility_range_end
	batch.visibility_range_begin_margin = port.visibility_range_begin_margin
	batch.visibility_range_end_margin = port.visibility_range_end_margin
	batch.visibility_range_fade_mode = port.visibility_range_fade_mode
	batch.set_meta("authored_instance_transforms", [port.transform, starboard.transform])
	batch.set_meta("visual_only", true)
	(port.get_parent() as Node3D).add_child(batch)
	_close_plume_batch = batch
	_close_plume_sources.assign([port, starboard])
	# The authored nodes remain live, visible and transform-authoritative; a zero
	# renderer-layer mask prevents their two legacy submissions from duplicating
	# the MultiMesh copies.
	port.layers = 0
	starboard.layers = 0
	_sync_close_plume_batch()


func _sync_close_plume_batch() -> void:
	if _close_plume_batch == null or not is_instance_valid(_close_plume_batch) \
			or _close_plume_batch.multimesh == null or _close_plume_sources.size() != 2:
		return
	var any_visible := false
	var authored_transforms: Array[Transform3D] = []
	var batch_bounds := AABB()
	var batch_mesh := _close_plume_batch.multimesh.mesh
	for index in _close_plume_sources.size():
		var source := _close_plume_sources[index]
		if not is_instance_valid(source):
			return
		_close_plume_batch.multimesh.set_instance_transform(index, source.transform)
		authored_transforms.append(source.transform)
		var instance_bounds := _transformed_aabb(batch_mesh.get_aabb(), source.transform)
		batch_bounds = instance_bounds if index == 0 else batch_bounds.merge(instance_bounds)
		any_visible = any_visible or source.visible
	# Headless rendering has no readable MultiMesh buffer, so retain the exact
	# CPU-authored transforms beside the renderer resource for focused checks.
	_close_plume_batch.set_meta("authored_instance_transforms", authored_transforms)
	_close_plume_batch.multimesh.custom_aabb = batch_bounds
	_close_plume_batch.visible = any_visible


static func _meshes_render_identically(
	left: Mesh, right: Mesh, material_override: Material
) -> bool:
	if left == null or right == null \
			or left.get_surface_count() != right.get_surface_count() \
			or not left.get_aabb().is_equal_approx(right.get_aabb()) \
			or not _material_is_texture_free(material_override):
		return false
	for surface_index in left.get_surface_count():
		if left.surface_get_primitive_type(surface_index) != right.surface_get_primitive_type(surface_index) \
				or left.surface_get_format(surface_index) != right.surface_get_format(surface_index):
			return false
		var left_arrays := left.surface_get_arrays(surface_index)
		var right_arrays := right.surface_get_arrays(surface_index)
		if left_arrays.size() != right_arrays.size():
			return false
		for array_index in left_arrays.size():
			if array_index == Mesh.ARRAY_TEX_UV:
				continue
			if left_arrays[array_index] != right_arrays[array_index]:
				return false
	return true


static func _material_is_texture_free(material: Material) -> bool:
	if not material is StandardMaterial3D:
		return false
	for property_value: Variant in material.get_property_list():
		var property := property_value as Dictionary
		var property_name := str(property.get("name", ""))
		if "texture" in property_name and material.get(property_name) is Texture2D:
			return false
	return true


static func _transformed_aabb(source: AABB, transform_value: Transform3D) -> AABB:
	var minimum := Vector3.INF
	var maximum := -Vector3.INF
	for x in [source.position.x, source.end.x]:
		for y in [source.position.y, source.end.y]:
			for z in [source.position.z, source.end.z]:
				var point := transform_value * Vector3(x, y, z)
				minimum = minimum.min(point)
				maximum = maximum.max(point)
	return AABB(minimum, maximum - minimum)


func _update_zenith_engine_presentation(delta: float) -> void:
	var telemetry := get_telemetry()
	var engine_state := StringName(telemetry.get("engine_state", ENGINE_OFFLINE))
	var active := not is_destroyed() and engine_state in [ENGINE_STARTING, ENGINE_ONLINE]
	var target_level := 0.0
	if engine_state == ENGINE_STARTING:
		target_level = 0.28
	elif engine_state == ENGINE_ONLINE:
		target_level = 0.48 + clampf(velocity.length() / maxf(maximum_speed, 1.0), 0.0, 1.0) * 0.52
		var damage := get_damage_presentation()
		if damage != null:
			target_level *= clampf(damage.get_engine_power_multiplier(), 0.0, 1.0)
	for plume in _engine_plumes:
		if not is_instance_valid(plume):
			continue
		plume.visible = active
		var base_scale := _plume_base_scales.get(plume.get_instance_id(), Vector3.ONE) as Vector3
		var target_scale := base_scale
		target_scale.z = base_scale.z * (0.55 + target_level * 1.25) if active else base_scale.z
		plume.scale = plume.scale.lerp(target_scale, 1.0 - exp(-10.0 * maxf(delta, 0.0)))
	_sync_close_plume_batch()


func _sync_zenith_engine_presentation_immediately() -> void:
	var telemetry := get_telemetry()
	var engine_state := StringName(telemetry.get("engine_state", ENGINE_OFFLINE))
	var active := not is_destroyed() and engine_state in [ENGINE_STARTING, ENGINE_ONLINE]
	for plume in _engine_plumes:
		if not is_instance_valid(plume):
			continue
		plume.visible = active
		var base_scale := _plume_base_scales.get(plume.get_instance_id(), Vector3.ONE) as Vector3
		var scale_value := base_scale
		scale_value.z = base_scale.z * (0.90 if active else 1.0)
		plume.scale = scale_value
	_sync_close_plume_batch()


func _sync_zenith_canopy_immediately() -> void:
	if _authored_presentation != null \
		and _authored_presentation.has_method("set_canopy_fraction"):
		_authored_presentation.call("set_canopy_fraction", 1.0 if is_canopy_open() else 0.0)


func _get_authored_audit() -> Dictionary:
	if _authored_presentation == null \
		or not is_instance_valid(_authored_presentation) \
		or not _authored_presentation.has_method("get_asset_audit_report"):
		return {}
	return (_authored_presentation.call("get_asset_audit_report") as Dictionary).duplicate(true)


func _audit_authored_contract(audit: Dictionary, violations: Array[Dictionary]) -> void:
	if StringName(audit.get("asset_id", &"")) != AUTHORED_ASSET_ID \
		or StringName(audit.get("evidence_scope", &"")) != EVIDENCE_SCOPE \
		or bool(audit.get("historical_geometry_authenticated", true)):
		_violation(violations, &"authored_evidence_drift", "authored_asset.evidence", "authored evidence boundary drifted")
	if not bool(audit.get("presentation_only", false)) \
		or bool(audit.get("gameplay_authority", true)) \
		or bool(audit.get("collision_authority", true)) \
		or int(audit.get("forbidden_authority_node_count", -1)) != 0:
		_violation(violations, &"imported_authority_drift", "authored_asset.authority", "imported art gained gameplay authority")
	if not bool(audit.get("source_core_removable", false)) \
		or not bool(audit.get("modern_systems_removable", false)):
		_violation(violations, &"source_modern_boundary_drift", "authored_asset.hierarchy", "source and modern roots lost their modular boundary")
	if not bool(audit.get("whole_ship_lod_atomic", false)) \
		or not bool(audit.get("far_lod_unbounded", false)):
		_violation(violations, &"lod_contract_drift", "authored_asset.lod", "whole-ship LOD contract drifted")
	if int(audit.get("close_triangle_count", -1)) != EXPECTED_CLOSE_TRIANGLES \
		or int(audit.get("far_triangle_count", -1)) != EXPECTED_FAR_TRIANGLES \
		or int(audit.get("runtime_mesh_count", -1)) != EXPECTED_RUNTIME_MESHES \
		or int(audit.get("runtime_surface_count", -1)) != EXPECTED_RUNTIME_SURFACES \
		or int(audit.get("material_role_count", -1)) != EXPECTED_MATERIAL_ROLES:
		_violation(violations, &"authored_budget_drift", "authored_asset.metrics", "authored topology or material counts drifted")
	var minimum := audit.get("bounds_minimum", Vector3.INF) as Vector3
	var maximum := audit.get("bounds_maximum", Vector3.INF) as Vector3
	if minimum.distance_to(EXPECTED_BOUNDS_MINIMUM) > 0.002 \
		or maximum.distance_to(EXPECTED_BOUNDS_MAXIMUM) > 0.002:
		_violation(violations, &"authored_bounds_drift", "authored_asset.bounds", "authored visual bounds drifted")
	if not bool(audit.get("raw_source_glb_hash_verified", false)):
		_violation(violations, &"authored_hash_drift", "authored_asset.glb_sha256", "authored GLB hash verification failed")
	if not bool(audit.get("collision_proposal_ready", false)) \
		or int(audit.get("collision_proposal_shape_count", -1)) != COLLISION_SPECS.size() \
		or float(audit.get("collision_proposal_maximum_miss_m", INF)) > 0.020 \
		or float(audit.get("collision_proposal_reverse_bound_m", INF)) > 0.150 \
		or float(audit.get("boarding_capsule_clearance_m", 0.0)) < 0.05 \
		or float(audit.get("boarding_collision_clearance_m", 0.0)) < 0.05 \
		or not bool(audit.get("boarding_route_clear", false)) \
		or float(audit.get("boarding_route_clearance_m", 0.0)) < 0.05 \
		or (audit.get("boarding_area_center", Vector3.INF) as Vector3).distance_to(
			EXPECTED_ANCHORS[&"BoardingPoint"] + Vector3.UP * 0.5
		) > 0.0001:
		_violation(violations, &"authored_collision_witness_drift", "authored_asset.collision_proposal", "non-authoritative authored collision witness drifted")


func _audit_functional_authority(violations: Array[Dictionary]) -> void:
	if _functional_cockpit == null or not is_instance_valid(_functional_cockpit) \
		or _functional_cockpit.get_parent() != _zenith_visual:
		_violation(violations, &"functional_cockpit_drift", "ZenithVisual/CockpitInterior", "functional cockpit identity or parent drifted")
	if _functional_canopy == null or not is_instance_valid(_functional_canopy) \
		or _functional_canopy.get_parent() != _zenith_visual:
		_violation(violations, &"functional_canopy_drift", "ZenithVisual/CanopyHinge", "functional canopy identity or parent drifted")
	var functional_nodes := {
		&"PilotSeatAnchor": get_pilot_seat_anchor(),
		&"BoardingEntry": _functional_cockpit.get_node_or_null("BoardingEntry") if _functional_cockpit != null else null,
		&"CockpitCamera": _functional_cockpit.get_node_or_null("CockpitCamera") if _functional_cockpit != null else null,
		&"BoardingPoint": get_node_or_null("BoardingPoint"),
		&"ExitPoint": get_node_or_null("ExitPoint"),
		&"LeftMuzzle": get_node_or_null("LeftMuzzle"),
		&"RightMuzzle": get_node_or_null("RightMuzzle"),
		&"DockingReceiver": get_node_or_null("DockingReceiver"),
	}
	for anchor_name: StringName in functional_nodes:
		var node := functional_nodes[anchor_name] as Node3D
		if node == null or not is_instance_valid(node):
			_violation(violations, &"functional_anchor_missing", str(anchor_name), "functional anchor is missing")
			continue
		if not node.is_inside_tree() or not is_inside_tree():
			_violation(violations, &"functional_anchor_unavailable", str(anchor_name), "functional anchor is outside the active tree")
			continue
		var local_position := (
			_zenith_visual.to_local(node.global_position)
			if _zenith_visual != null and _zenith_visual.is_ancestor_of(node)
			else to_local(node.global_position)
		)
		if local_position.distance_to(EXPECTED_ANCHORS[anchor_name]) > 0.002:
			_violation(violations, &"functional_anchor_drift", str(anchor_name), "functional anchor drifted from authored witness")
	var boarding_area := get_node_or_null("ShipBoardingArea") as ShipBoardingArea
	if boarding_area == null or boarding_area.get_ship() != self \
		or boarding_area.position.distance_to(EXPECTED_ANCHORS[&"BoardingPoint"] + Vector3.UP * 0.5) > 0.002:
		_violation(violations, &"boarding_authority_drift", "ShipBoardingArea", "boarding authority or position drifted")
	var damage := get_damage_presentation()
	if damage == null \
		or damage.spark_anchor.distance_to(EXPECTED_ANCHORS[&"DamagePortWing"]) > 0.002 \
		or damage.smoke_anchor.distance_to(EXPECTED_ANCHORS[&"DamageCenter"]) > 0.002 \
		or damage.warning_anchor.distance_to(EXPECTED_ANCHORS[&"DamageStarboardWing"]) > 0.002:
		_violation(violations, &"damage_anchor_drift", "HeroDamagePresentation", "runtime damage anchors drifted from authored witnesses")
	if _authored_presentation != null and _authored_presentation.has_method("get_canopy_pivot"):
		var authored_canopy := _authored_presentation.call("get_canopy_pivot") as Node3D
		if authored_canopy == null:
			_violation(violations, &"authored_canopy_missing", "CanopyPivot", "authored canopy pivot is missing")
	var plume_names := PackedStringArray()
	for plume in get_zenith_engine_plumes():
		plume_names.append(str(plume.name))
	plume_names.sort()
	var expected_plumes := PackedStringArray(REQUIRED_PLUME_NAMES)
	expected_plumes.sort()
	if plume_names != expected_plumes:
		_violation(violations, &"plume_roster_drift", "engine_plumes", "protected plume roster drifted")


func _audit_collision_authority(violations: Array[Dictionary]) -> void:
	if collision_layer != PhysicsLayers.SHIP_BODY_LAYER \
		or collision_mask != PhysicsLayers.SHIP_BODY_MASK:
		_violation(violations, &"collision_filter_drift", "collision", "ship collision layer or mask drifted")
	var direct_collisions: Array[CollisionShape3D] = []
	for child in get_children():
		if child is CollisionShape3D:
			direct_collisions.append(child as CollisionShape3D)
	if direct_collisions.size() != COLLISION_SPECS.size():
		_violation(violations, &"collision_roster_drift", "collision", "direct collision shape count drifted")
	var live_order := PackedStringArray()
	for collision in direct_collisions:
		live_order.append(str(collision.name))
	var expected_order := PackedStringArray()
	for spec in COLLISION_SPECS:
		expected_order.append(str(spec.get("name", &"")))
	if live_order != expected_order:
		_violation(violations, &"collision_order_drift", "collision", "ordered runtime mixed-shape roster drifted")
	var live_type_counts := {}
	for spec in COLLISION_SPECS:
		var collision := get_node_or_null(NodePath(str(spec.get("name", &"")))) as CollisionShape3D
		var shape := collision.shape if collision != null else null
		if collision == null or shape == null:
			_violation(violations, &"collision_shape_missing", str(spec.get("name", &"")), "runtime collision shape is missing")
			continue
		var expected_position := spec.get("position", Vector3.INF) as Vector3
		var expected_rotation := spec.get("rotation_degrees", Vector3.INF) as Vector3
		var expected_basis := Basis.from_euler(expected_rotation * PI / 180.0)
		var expected_type := StringName(spec.get("shape_type", &""))
		var live_type := StringName(shape.get_class())
		live_type_counts[live_type] = int(live_type_counts.get(live_type, 0)) + 1
		if collision.disabled or collision.top_level \
			or collision.position.distance_to(expected_position) > 0.0001 \
			or collision.rotation_degrees.distance_to(expected_rotation) > 0.0001 \
			or not collision.basis.is_equal_approx(expected_basis):
			_violation(violations, &"collision_transform_drift", str(collision.name), "runtime collision transform or enabled state drifted")
		if live_type != expected_type:
			_violation(violations, &"collision_type_drift", str(collision.name), "runtime collision resource type drifted")
			continue
		if shape is ConvexPolygonShape3D:
			var expected_points := _packed_points(spec.get("points", []))
			var live_points := (shape as ConvexPolygonShape3D).points
			var expected_runtime_digest := str(spec.get(
				"runtime_points_sha256", spec.get("points_sha256", "")
			))
			if live_points != expected_points \
					or _convex_points_digest(live_points, spec.get("points", [])) != expected_runtime_digest:
				_violation(violations, &"collision_point_digest_drift", str(collision.name), "runtime convex points or point digest drifted")
		elif shape is CylinderShape3D:
			var cylinder := shape as CylinderShape3D
			if not is_equal_approx(cylinder.radius, float(spec.get("radius", 0.0))) \
					or not is_equal_approx(cylinder.height, float(spec.get("height", 0.0))):
				_violation(violations, &"collision_parameter_drift", str(collision.name), "runtime cylinder parameters drifted")
		elif shape is BoxShape3D:
			var expected_size := spec.get("size", Vector3.ZERO) as Vector3
			if (shape as BoxShape3D).size.distance_to(expected_size) > 0.0001:
				_violation(violations, &"collision_parameter_drift", str(collision.name), "runtime box size drifted")
	if live_type_counts != COLLISION_TYPE_COUNTS:
		_violation(violations, &"collision_type_roster_drift", "collision", "runtime mixed-shape type counts drifted")
	var landing := get_landing_collision_report()
	var landing_bounds := landing.get("local_bounds", AABB()) as AABB
	if not bool(landing.get("valid", false)) \
		or int(landing.get("shape_count", -1)) != COLLISION_SPECS.size() \
		or landing_bounds.position.distance_to(EXPECTED_LANDING_COLLISION_BOUNDS.position) > 0.0001 \
		or landing_bounds.size.distance_to(EXPECTED_LANDING_COLLISION_BOUNDS.size) > 0.0001:
		_violation(violations, &"landing_envelope_drift", "collision.landing", "landing collision report drifted")


func _audit_runtime_identities(violations: Array[Dictionary]) -> void:
	if _identity_snapshot.is_empty() or _capture_runtime_identities() != _identity_snapshot:
		_violation(violations, &"runtime_resource_identity_drift", "runtime_identities", "runtime nodes or resources were replaced")


func _capture_runtime_identities() -> Dictionary:
	var collision_shape_ids := PackedInt64Array()
	for spec in COLLISION_SPECS:
		var collision := get_node_or_null(NodePath(str(spec.get("name", &"")))) as CollisionShape3D
		collision_shape_ids.append(collision.shape.get_instance_id() if collision != null and collision.shape != null else 0)
	var plume_node_ids := PackedInt64Array()
	var plume_mesh_ids := PackedInt64Array()
	for plume_name in REQUIRED_PLUME_NAMES:
		var plume: MeshInstance3D = null
		for candidate in _engine_plumes:
			if is_instance_valid(candidate) and candidate.name == plume_name:
				plume = candidate
				break
		plume_node_ids.append(plume.get_instance_id() if plume != null else 0)
		plume_mesh_ids.append(plume.mesh.get_instance_id() if plume != null and plume.mesh != null else 0)
	var definition := get_ship_definition()
	var damage := get_damage_presentation()
	var audio := get_ship_audio_rig()
	var docking_receiver := get_node_or_null("DockingReceiver") as Marker3D
	var asset_root: Node3D = null
	var canopy_pivot: Node3D = null
	if _authored_presentation != null and is_instance_valid(_authored_presentation):
		asset_root = _authored_presentation.call("get_asset_root") as Node3D
		canopy_pivot = _authored_presentation.call("get_canopy_pivot") as Node3D
	return {
		"visual_root_id": _zenith_visual.get_instance_id() if _zenith_visual != null and is_instance_valid(_zenith_visual) else 0,
		"presentation_id": _authored_presentation.get_instance_id() if _authored_presentation != null and is_instance_valid(_authored_presentation) else 0,
		"asset_root_id": asset_root.get_instance_id() if asset_root != null else 0,
		"authored_canopy_id": canopy_pivot.get_instance_id() if canopy_pivot != null else 0,
		"functional_cockpit_id": _functional_cockpit.get_instance_id() if _functional_cockpit != null and is_instance_valid(_functional_cockpit) else 0,
		"functional_canopy_id": _functional_canopy.get_instance_id() if _functional_canopy != null and is_instance_valid(_functional_canopy) else 0,
		"pilot_anchor_id": get_pilot_seat_anchor().get_instance_id() if get_pilot_seat_anchor() != null else 0,
		"docking_receiver_id": docking_receiver.get_instance_id() if docking_receiver != null else 0,
		"definition_id": definition.get_instance_id() if definition != null else 0,
		"damage_presentation_id": damage.get_instance_id() if damage != null else 0,
		"audio_rig_id": audio.get_instance_id() if audio != null else 0,
		"collision_shape_resource_ids": collision_shape_ids,
		"plume_node_ids": plume_node_ids,
		"plume_mesh_resource_ids": plume_mesh_ids,
		"close_plume_batch_id": (
			_close_plume_batch.get_instance_id()
			if _close_plume_batch != null and is_instance_valid(_close_plume_batch) else 0
		),
		"close_plume_multimesh_id": (
			_close_plume_batch.multimesh.get_instance_id()
			if _close_plume_batch != null and is_instance_valid(_close_plume_batch)
				and _close_plume_batch.multimesh != null else 0
		),
	}


