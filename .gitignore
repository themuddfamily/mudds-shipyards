.godot/
# Keep generated exports/distributions ignored while tracking the Godot import
# boundary that prevents prior outputs from being scanned as nested projects.
builds/*
!builds/
!builds/.gdignore
artifacts/
*.log
__pycache__/
*.pyc
*.blend1
docs/research/private/
docs/research/tmp/

# Claude Code transient agent worktrees and local settings
.claude/worktrees/
.claude/settings.local.json
