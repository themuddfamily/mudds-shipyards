	_check(cockpit_camera != null and cockpit_camera.position.distance_to(EXPECTED_ANCHORS[&"CockpitCamera"]) < 0.002, "cockpit camera matches authored witness")
	zenith.set_cockpit_view(false)
	zenith.set_piloted(false)

	var presentation := zenith.get_zenith_authored_presentation()
	var authored_canopy := presentation.call("get_canopy_pivot") as Node3D
	var functional_canopy_id := functional_canopy.get_instance_id()
	var authored_canopy_id := authored_canopy.get_instance_id()
