	_check(boarding_hits.is_empty(), "production player capsule has physical clearance at the moved BoardingPoint")
	_check(boarding_area.global_position.distance_to(zenith.to_global(EXPECTED_ANCHORS[&"BoardingPoint"] + Vector3.UP * 0.5)) < 0.002, "boarding trigger remains exactly centred above the clear player root")
	var damage := zenith.get_damage_presentation()
	_check(damage != null and damage.spark_anchor.distance_to(Vector3(-4.55, 0.18, 0.2)) < 0.002 and damage.smoke_anchor.distance_to(Vector3(0.0, 0.48, 0.0)) < 0.002 and damage.warning_anchor.distance_to(Vector3(4.55, 0.18, 0.2)) < 0.002, "runtime damage anchors align to all three authored witnesses")

	var visual := zenith.get_zenith_visual_root()
	var functional_cockpit := visual.get_node_or_null("CockpitInterior") as Node3D
	var functional_canopy := visual.get_node_or_null("CanopyHinge") as Node3D
	_check(functional_cockpit != null and functional_cockpit.get_child_count() == 3, "only the inherited seat, entry and cockpit camera authority survive visual replacement")
	_check(functional_canopy != null and functional_canopy.get_child_count() == 0, "hidden functional canopy hinge survives without Torrent art")
