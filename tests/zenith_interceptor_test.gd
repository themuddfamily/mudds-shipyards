	if berth == null:
		world.queue_free()
		return
	_check(berth.get_landing_half_extents().is_equal_approx(Vector3(8.4, 4.6, 7.4)), "production Zenith berth retains its strict physical volume")
	_check(berth.get_compatibility_tags() == PackedStringArray(["zenith_b7"]), "production Zenith berth accepts only the exact compatibility tag")
