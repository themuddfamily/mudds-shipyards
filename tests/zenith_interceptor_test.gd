	var seat := zenith.get_pilot_seat_anchor()
	_check(seat != null and seat.global_position.distance_to(zenith.to_global(EXPECTED_ANCHORS[&"PilotSeatAnchor"])) < 0.002, "functional pilot seat aligns to authored witness")
	# RE-FROZEN 2026-08-15 with the seat anchor: 1.30 -> 1.35 m. `BoardingEntry`
	# is a hull-surface standing spot and did not move, so dropping the seat
	# 0.47 m lengthened this step from a measured 1.203 m to a measured 1.306 m.
	# It is still far shorter than the 1.623 m entry-to-seat step the shared
	# HeroShip cockpit uses, and the 0.51 m drop from entry to seat now matches
	# that cockpit's 0.76 m drop in kind instead of the old, nearly level 0.04 m.
	_check(seat != null and seat.global_position.distance_to(zenith.get_boarding_entry_transform().origin) < 1.35, "entry-to-seat transition is short and physical")

	var collision := zenith.get_landing_collision_report()
	var landing_bounds := collision.local_bounds as AABB
	_check(bool(collision.valid) and int(collision.shape_count) == 24, "Zenith owns exactly twenty-four runtime mixed collision shapes")
	_check(landing_bounds.position.distance_to(EXPECTED_COLLISION_BOUNDS.position) <= 0.0001 and landing_bounds.size.distance_to(EXPECTED_COLLISION_BOUNDS.size) <= 0.0001, "landing envelope matches the independent complete V2 bounds")
	var collision_names := PackedStringArray()
	for child in zenith.get_children():
		if child is CollisionShape3D:
			collision_names.append(str(child.name))
	_check(collision_names == PackedStringArray(EXPECTED_COLLISION_ORDER), "collision authority uses the exact ordered twenty-four-shape roster")
	var exact_live_oracle := true
	var live_shape_ids := PackedInt64Array()
	var live_type_counts := {}
	for collision_name in EXPECTED_COLLISION_ORDER:
		var expected := EXPECTED_COLLISION_SHAPES[collision_name] as Dictionary
		var live := zenith.get_node_or_null(NodePath(collision_name)) as CollisionShape3D
		var shape := live.shape if live != null else null
		if live == null or shape == null:
			exact_live_oracle = false
			continue
		var expected_rotation := expected.rotation_degrees as Vector3
		exact_live_oracle = exact_live_oracle \
			and not live.disabled and not live.top_level \
			and shape.get_class() == str(expected.shape_type) \
			and live.position.distance_to(expected.position as Vector3) <= 0.0001 \
			and live.rotation_degrees.distance_to(expected_rotation) <= 0.0001 \
			and live.basis.is_equal_approx(Basis.from_euler(expected_rotation * PI / 180.0))
		var shape_type := StringName(shape.get_class())
		live_type_counts[shape_type] = int(live_type_counts.get(shape_type, 0)) + 1
		if shape is ConvexPolygonShape3D:
			var expected_points := _packed_test_points(expected.get("points", []))
			var live_points := (shape as ConvexPolygonShape3D).points
			exact_live_oracle = exact_live_oracle \
				and live_points == expected_points \
				and _runtime_points_digest(live_points, expected.get("points", [])) == str(expected.runtime_points_sha256)
		elif shape is CylinderShape3D:
			exact_live_oracle = exact_live_oracle \
				and is_equal_approx((shape as CylinderShape3D).radius, float(expected.radius)) \
				and is_equal_approx((shape as CylinderShape3D).height, float(expected.height))
		elif shape is BoxShape3D:
			exact_live_oracle = exact_live_oracle \
				and (shape as BoxShape3D).size.distance_to(expected.size as Vector3) <= 0.0001
		live_shape_ids.append(shape.get_instance_id())
	_check(exact_live_oracle, "every live shape exactly matches the independent type/transform/point-or-parameter oracle")
	_check(live_type_counts == EXPECTED_COLLISION_TYPE_COUNTS, "live roster contains exactly eighteen convex, three cylinder and three box resources")
	var runtime_collision := zenith.get_zenith_collision_contract_report()
	_check(bool(runtime_collision.valid) and str(runtime_collision.oracle_id) == "zenith_b7_runtime_24_mixed_v2", "runtime collision contract is green under its stable V2 oracle ID")
	_check(str(runtime_collision.geometry_sha256) == EXPECTED_COLLISION_GEOMETRY_SHA256, "runtime publishes the exact opaque V2 geometry SHA")
	_check(str(runtime_collision.authority) == "runtime_hard_coded" and not bool(runtime_collision.manifest_loaded_for_authority) and not bool(runtime_collision.imported_collision_authority), "hard-coded runtime owns collision without manifest or imported-art authority")
	_check(int(runtime_collision.shape_count) == 24 and (runtime_collision.ordered_names as PackedStringArray) == PackedStringArray(EXPECTED_COLLISION_ORDER), "public collision report preserves exact mixed-shape count and order")
	_check((runtime_collision.shape_type_counts as Dictionary) == EXPECTED_COLLISION_TYPE_COUNTS, "public collision report preserves exact mixed-shape type counts")
	var reported_shape_ids := PackedInt64Array()
	var live_shape_records := runtime_collision.get("live_shapes", []) as Array
	for shape_record_value in live_shape_records:
		var shape_record := shape_record_value as Dictionary
		reported_shape_ids.append(int(shape_record.shape_resource_id))
	_check(reported_shape_ids == live_shape_ids, "public collision report exposes the exact live shape-resource identities")
	_check(_manifest_collision_matches_hard_coded_oracle(), "current non-authoritative manifest evidence matches the independent runtime-test oracle")
	_check(zenith.collision_layer == PhysicsLayers.SHIP_BODY_LAYER and zenith.collision_mask == PhysicsLayers.SHIP_BODY_MASK, "Zenith uses canonical ship collision filters")

	await physics_frame
	var live_player_capsule := CapsuleShape3D.new()
	live_player_capsule.radius = 0.38
	live_player_capsule.height = 1.94
	var capsule_query := PhysicsShapeQueryParameters3D.new()
	capsule_query.shape = live_player_capsule
	capsule_query.transform = zenith.global_transform * Transform3D(
		Basis.IDENTITY,
		EXPECTED_ANCHORS[&"BoardingPoint"] + Vector3.UP * 0.97
	)
	capsule_query.collision_mask = PhysicsLayers.SHIP_BODY_LAYER
	capsule_query.collide_with_bodies = true
	capsule_query.collide_with_areas = false
