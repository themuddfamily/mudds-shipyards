func _test_engine_flight_weapon_damage_reuse(zenith: ZenithInterceptor) -> void:
	var fired_events: Array[Dictionary] = []
	zenith.projectile_fired.connect(func(origin: Vector3, direction: Vector3) -> void:
		fired_events.append({"origin": origin, "direction": direction})
	)
	zenith.engine_start_time = 0.04
	zenith.weapon_cooldown = 0.03
	zenith.set_piloted(true)
	zenith.request_engine_start()
	_check(str(zenith.get_telemetry().engine_state) == "STARTING", "Zenith enters inherited STARTING state")
	_check(_all_plumes_visible(zenith, true), "all close/far plumes enable during startup")
	for _index in 8:
		await physics_frame
	_check(str(zenith.get_telemetry().engine_state) == "ONLINE", "Zenith completes inherited engine startup")
	_check(_all_plumes_visible(zenith, true), "all close/far plumes remain enabled online")
	var plume_scales_are_finite := true
	for plume in zenith.get_zenith_engine_plumes():
		plume_scales_are_finite = plume_scales_are_finite and plume.scale.is_finite() and plume.scale.x >= 0.0 and plume.scale.y >= 0.0 and plume.scale.z >= 0.0
	_check(plume_scales_are_finite, "runtime plume scaling remains finite and nonnegative")

	var start_position := zenith.global_position
	var start_basis := zenith.global_basis
	Input.action_press("move_forward")
	Input.action_press("roll_right")
	for _index in 10:
		await physics_frame
	Input.action_release("move_forward")
	Input.action_release("roll_right")
	_check(zenith.velocity.length() > 0.5 and zenith.global_position.distance_to(start_position) > 0.01, "real flight input accelerates and moves Zenith")
	_check(zenith.global_basis.x.distance_to(start_basis.x) > 0.01, "real roll input changes Zenith attitude")

	var expected_left_origin := (zenith.get_node("LeftMuzzle") as Marker3D).global_position
	Input.action_press("fire")
	await physics_frame
	Input.action_release("fire")
	_check(fired_events.size() == 1, "Zenith fires through the inherited command path")
	if fired_events.size() == 1:
		_check((fired_events[0].origin as Vector3).distance_to(expected_left_origin) < 0.002, "first pulse originates at the exact port muzzle transform for its fire tick")
		_check((fired_events[0].direction as Vector3).dot(-zenith.global_basis.z) > 0.85, "pulse follows the visible nose direction")
	for _index in 4:
		await physics_frame
	var expected_right_origin := (zenith.get_node("RightMuzzle") as Marker3D).global_position
	Input.action_press("fire")
	await physics_frame
	Input.action_release("fire")
	_check(fired_events.size() == 2, "Zenith alternates a second pulse after cooldown")
	if fired_events.size() == 2:
		_check((fired_events[1].origin as Vector3).distance_to(expected_right_origin) < 0.002, "second pulse originates at the exact starboard muzzle transform for its fire tick")

	var hull_before := float(zenith.get_telemetry().hull)
	zenith.apply_damage(18.0, zenith.to_global(Vector3(-4.55, 0.18, 0.2)), Vector3.UP)
	await physics_frame
	_check(float(zenith.get_telemetry().hull) < hull_before and not zenith.is_destroyed(), "partial damage reduces Zenith hull without destroying it")
	zenith.apply_damage(zenith.maximum_hull + 1.0, zenith.global_position, Vector3.UP)
	await physics_frame
	_check(zenith.is_destroyed(), "lethal damage enters inherited destroyed lifecycle")
	_check(zenith.collision_layer == 0 and zenith.collision_mask == 0, "destroyed Zenith disables collision authority")
	_check(_all_plumes_visible(zenith, false), "destruction stops every authored plume")

	var identity_before := zenith.get_zenith_runtime_identity_report().baseline as Dictionary
	var reset_transform := Transform3D(Basis(Vector3.UP, deg_to_rad(19.0)), Vector3(8.0, 2.0, -11.0))
	zenith.reset_for_reuse(reset_transform)
	await physics_frame
	await physics_frame
	_check(not zenith.is_destroyed() and zenith.is_boardable(), "reset restores the same Zenith as a boardable ship")
	_check(zenith.global_position.is_equal_approx(reset_transform.origin), "reset restores requested berth transform")
	_check(zenith.collision_layer == PhysicsLayers.SHIP_BODY_LAYER and zenith.collision_mask == PhysicsLayers.SHIP_BODY_MASK, "reset restores canonical collision filters")
	_check(_all_plumes_visible(zenith, false), "reset leaves every plume offline")
	_check(bool(zenith.get_zenith_runtime_identity_report().stable), "reset preserves all pinned runtime/resource identities")
	_check((zenith.get_zenith_runtime_identity_report().current as Dictionary) == identity_before, "reset reuses the exact authored, collision, damage, audio and definition resources")
	_check(bool(zenith.get_zenith_audit_report().valid), "reset returns the complete Zenith audit to green")


func _test_strict_berth_fit_capture_and_landing(zenith: ZenithInterceptor) -> void:
	var world := SHIPYARD_WORLD_SCENE.instantiate() as ShipyardWorld
