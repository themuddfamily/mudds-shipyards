	_test_root.queue_free()
	await process_frame


func _has_red_code(zenith: ZenithInterceptor, code: String) -> bool:
	var audit := zenith.get_zenith_audit_report()
	return not bool(audit.valid) and (audit.error_codes as PackedStringArray).has(code)


func _all_plumes_visible(zenith: ZenithInterceptor, expected: bool) -> bool:
	var plumes := zenith.get_zenith_engine_plumes()
	if plumes.size() != 4:
		return false
	for plume in plumes:
		if plume.visible != expected:
			return false
	return true


func _all_visible(nodes: Array, expected: bool) -> bool:
	if nodes.is_empty():
		return false
	for candidate in nodes:
		if not candidate is Node3D or (candidate as Node3D).visible != expected:
			return false
	return true


func _direct_names(node: Node) -> PackedStringArray:
	var result := PackedStringArray()
	for child in node.get_children():
		result.append(str(child.name))
	result.sort()
	return result


func _manifest_collision_matches_hard_coded_oracle() -> bool:
	var file := FileAccess.open(MANIFEST_PATH, FileAccess.READ)
	if file == null:
		return false
	var parsed: Variant = JSON.parse_string(file.get_as_text())
	if not parsed is Dictionary:
		return false
	var proposal := (parsed as Dictionary).get("collision_proposal", {}) as Dictionary
	var structural := proposal.get("structural_art_coverage", {}) as Dictionary
	var reverse_fit := proposal.get("reverse_fit", {}) as Dictionary
	var published_type_counts := proposal.get("shape_type_counts", {}) as Dictionary
	if not bool(proposal.get("ready", false)) \
			or bool(proposal.get("authority", true)) \
			or bool(proposal.get("collision_authority", true)) \
			or int(proposal.get("shape_count", -1)) != EXPECTED_COLLISION_ORDER.size() \
			or int(proposal.get("maximum_shape_count", -1)) != 24 \
			or str(proposal.get("shape_geometry_sha256", "")) != EXPECTED_COLLISION_GEOMETRY_SHA256 \
			or int(published_type_counts.get("ConvexPolygonShape3D", -1)) != 18 \
			or int(published_type_counts.get("CylinderShape3D", -1)) != 3 \
			or int(published_type_counts.get("BoxShape3D", -1)) != 3 \
			or int(structural.get("audited_vertex_count", -1)) != 19_378 \
			or float(structural.get("maximum_observed_miss_m", INF)) > 0.020001 \
			or int(structural.get("vertices_over_20mm", -1)) != 0 \
			or float(reverse_fit.get("conservative_continuous_upper_bound_m", INF)) > 0.150001:
		return false
	var shapes := proposal.get("shapes", []) as Array
	if shapes.size() != EXPECTED_COLLISION_ORDER.size():
		return false
	for index in EXPECTED_COLLISION_ORDER.size():
		var expected_name: String = EXPECTED_COLLISION_ORDER[index]
		var expected := EXPECTED_COLLISION_SHAPES[expected_name] as Dictionary
		var published := shapes[index] as Dictionary
		if str(published.get("name", "")) != expected_name \
				or bool(published.get("authority", true)) \
				or str(published.get("shape_type", "")) != str(expected.shape_type):
			return false
		if str(expected.shape_type) == "ConvexPolygonShape3D":
			var published_points := published.get("points", []) as Array
			var expected_points := expected.get("points", []) as Array
			if int(published.get("point_count", -1)) != expected_points.size() \
					or published_points.size() != expected_points.size() \
					or str(published.get("points_sha256", "")) != str(expected.manifest_points_sha256):
				return false
			for point_index in expected_points.size():
				if _json_vector3(published_points[point_index]) != (expected_points[point_index] as Vector3):
					return false
		elif str(expected.shape_type) == "CylinderShape3D":
			if _json_vector3(published.get("position", [])).distance_to(expected.position as Vector3) > 0.0001 \
					or _json_vector3(published.get("rotation_degrees", [])).distance_to(expected.rotation_degrees as Vector3) > 0.0001 \
					or not is_equal_approx(float(published.get("radius", 0.0)), float(expected.radius)) \
					or not is_equal_approx(float(published.get("height", 0.0)), float(expected.height)):
				return false
		elif str(expected.shape_type) == "BoxShape3D":
			if _json_vector3(published.get("position", [])).distance_to(expected.position as Vector3) > 0.0001 \
					or _json_vector3(published.get("rotation_degrees", [])).distance_to(expected.rotation_degrees as Vector3) > 0.0001 \
					or _json_vector3(published.get("size", [])).distance_to(expected.size as Vector3) > 0.0001:
				return false
	var boarding_capsule := proposal.get("production_boarding_capsule", {}) as Dictionary
	var boarding_area := proposal.get("boarding_area_witness", {}) as Dictionary
	var marker_witness := boarding_capsule.get("collision_marker_witness", {}) as Dictionary
	var boarding_route := proposal.get("boarding_route", {}) as Dictionary
	return _json_vector3(boarding_capsule.get("root_position", [])).distance_to(EXPECTED_ANCHORS[&"BoardingPoint"]) <= 0.0001 \
		and _json_vector3(boarding_capsule.get("center_offset", [])).distance_to(Vector3.UP * 0.97) <= 0.0001 \
		and is_equal_approx(float(boarding_capsule.get("radius", -1.0)), 0.38) \
		and is_equal_approx(float(boarding_capsule.get("total_height", -1.0)), 1.94) \
		and float(boarding_capsule.get("conservative_art_clearance_m", -1.0)) >= 0.05 \
		and float(marker_witness.get("conservative_continuous_clearance_m", -1.0)) >= 0.05 \
		and bool(boarding_route.get("clear", false)) \
		and _json_vector3(boarding_area.get("center", [])).distance_to(EXPECTED_ANCHORS[&"BoardingPoint"] + Vector3.UP * 0.5) <= 0.0001 \
		and is_equal_approx(float(boarding_area.get("radius", -1.0)), 4.5)


func _packed_test_points(value: Variant) -> PackedVector3Array:
	var result := PackedVector3Array()
	if not value is Array:
		return result
	for point_value in value as Array:
		result.append(point_value as Vector3)
	return result


func _runtime_points_digest(points: PackedVector3Array, canonical_points: Variant) -> String:
	var json_points: Array[Array] = []
	var canonical := canonical_points as Array if canonical_points is Array else []
	for index in points.size():
		var point := points[index]
		var sign_witness := canonical[index] as Vector3 if index < canonical.size() else point
		json_points.append([
			sign_witness.x if is_zero_approx(point.x) and is_zero_approx(sign_witness.x) else snappedf(point.x, 0.000001),
			sign_witness.y if is_zero_approx(point.y) and is_zero_approx(sign_witness.y) else snappedf(point.y, 0.000001),
			sign_witness.z if is_zero_approx(point.z) and is_zero_approx(sign_witness.z) else snappedf(point.z, 0.000001),
		])
	return JSON.stringify(json_points, "", false, false).sha256_text()


func _json_vector3(value: Variant) -> Vector3:
	if not value is Array or (value as Array).size() != 3:
		return Vector3(INF, INF, INF)
	var values := value as Array
	return Vector3(float(values[0]), float(values[1]), float(values[2]))


func _check(condition: bool, description: String) -> void:
	if condition:
		print("PASS: ", description)
	else:
		_failures.append(description)
		push_error("FAIL: " + description)


func _finish() -> void:
	Input.action_release("move_forward")
	Input.action_release("roll_right")
	Input.action_release("fire")
	if _failures.is_empty():
		print("ZENITH_INTERCEPTOR_TEST_OK")
		quit(0)
	else:
		print("ZENITH_INTERCEPTOR_TEST_FAILED: ", ", ".join(_failures))
		quit(1)
