var _failures: Array[String] = []
var _test_root: Node3D


func _init() -> void:
	call_deferred("_run")


func _run() -> void:
	_test_root = Node3D.new()
	_test_root.name = "ZenithInterceptorTestRoot"
	root.add_child(_test_root)
	var zenith := ZENITH_SCENE.instantiate() as ZenithInterceptor
	_check(zenith != null, "Zenith scene instantiates as ZenithInterceptor")
	if zenith == null:
		_finish()
		return
	_test_root.add_child(zenith)
	await process_frame
	await physics_frame
	await physics_frame

	_test_definition_and_evidence(zenith)
	_test_authored_asset_and_runtime_authority(zenith)
	await _test_boarding_collision_camera_and_canopy(zenith)
	_test_handling_difference(zenith)
	await _test_engine_flight_weapon_damage_reuse(zenith)
	await _test_strict_berth_fit_capture_and_landing(zenith)
	await _test_detach_readd_and_resource_identities(zenith)
	_test_structured_red_mutations(zenith)
	await _test_cleanup(zenith)
	_finish()


func _test_definition_and_evidence(zenith: ZenithInterceptor) -> void:
	var definition := zenith.get_ship_definition()
	_check(definition != null and definition.is_definition_valid(), "Zenith owns one valid ShipDefinition")
	if definition == null:
		return
	_check(definition.resource_path == "res://assets/ships/zenith_b7_observed.tres", "definition is the Zenith-only checked-in resource")
	_check(definition.get_ship_id() == &"zenith_b7_observed", "definition exposes exact Zenith ship ID")
	_check(zenith.get_ship_id() == &"zenith_b7_observed", "runtime applies exact Zenith ship ID")
	_check(zenith.get_home_berth_id() == &"zenith_fleet_dock_berth", "runtime exposes exact Fleet Dock berth ID")
	_check(definition.get_evidence_status_id() == &"provisional" and not definition.is_authenticated(), "B7 partial remains explicitly provisional")
	_check(definition.audio_profile_id == &"standard_fighter", "Zenith uses a declared immutable audio profile")
