		bounds,
		Vector3.ZERO,
		zenith.landing_maximum_speed,
		0.05
	)
	_check(bool(capture.valid) and bool(capture.assist_capture_accepted) and bool(capture.strict_dock_acceptance), "production assist capture accepts Zenith while preserving strict final fit")
	_check(bool(capture.capture_root_inside) and bool(capture.capture_hull_inside) and bool(capture.docked_hull_fits), "capture report proves broad approach and exact docked hull containment")

	zenith.reset_for_reuse(dock)
	await physics_frame
	var token := berth.try_reserve(zenith, zenith.get_ship_definition())
	_check(not token.is_empty(), "Zenith obtains the exact production berth lease")
	var landing_signals := {"completed": 0}
	zenith.landing_completed.connect(
		func() -> void: landing_signals["completed"] = int(landing_signals["completed"]) + 1,
		CONNECT_ONE_SHOT
	)
