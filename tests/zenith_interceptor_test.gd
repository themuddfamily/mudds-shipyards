	_check(int(landing_signals.completed) == 1 and berth.get_occupant() == zenith, "landing completes once and converts the exact lease to occupancy")
	_check(bool(landing_report.contract_accepted) and bool(landing_report.strict_dock_acceptance), "completed landing retains strict dock acceptance evidence")
	_check(int((landing_report.collision as Dictionary).shape_count) == 24, "completed landing report retains the twenty-four-shape collision snapshot")
	_check(str(zenith.get_telemetry().landing_abort_reason).is_empty(), "production landing emits no obstruction or authority abort")

	berth.release(zenith, token)
	zenith.reset_for_reuse(Transform3D(Basis.IDENTITY, Vector3(8.0, 2.0, -11.0)))
	await physics_frame
	world.queue_free()
	await process_frame
	_check(bool(zenith.get_zenith_audit_report().valid), "post-landing reset preserves the exact collision oracle and resource identities")


func _test_detach_readd_and_resource_identities(zenith: ZenithInterceptor) -> void:
	var baseline := zenith.get_zenith_runtime_identity_report().baseline as Dictionary
	var visual := zenith.get_zenith_visual_root()
	zenith.remove_child(visual)
	var detached_visual_audit := zenith.get_zenith_audit_report()
	_check(not bool(detached_visual_audit.valid) and (detached_visual_audit.error_codes as PackedStringArray).has("visual_root_identity_drift"), "detached visual root fails red with stable identity code")
	zenith.add_child(visual)
	_check(bool(zenith.get_zenith_audit_report().valid), "readding the same visual root returns audit to green")
	_check((zenith.get_zenith_runtime_identity_report().current as Dictionary) == baseline, "visual detach/readd preserves all pinned resources")

	_test_root.remove_child(zenith)
	await process_frame
	_test_root.add_child(zenith)
	await process_frame
	await physics_frame
	_check(bool(zenith.get_zenith_runtime_identity_report().stable), "whole-ship detach/reentry preserves runtime node/resource identities")
	_check((zenith.get_zenith_runtime_identity_report().current as Dictionary) == baseline, "whole-ship reentry does not rebuild authored meshes or collision shapes")
	_check(bool(zenith.get_zenith_audit_report().valid), "whole-ship reentry returns green without rerunning ready")
	_check(zenith.is_boardable() and _all_plumes_visible(zenith, false), "reentered reset ship remains boardable and powered down")


func _test_structured_red_mutations(zenith: ZenithInterceptor) -> void:
	var boarding := zenith.get_node("BoardingPoint") as Marker3D
	var boarding_position := boarding.position
	boarding.position.x += 0.25
	_check(_has_red_code(zenith, "functional_anchor_drift"), "marker drift produces structured functional_anchor_drift")
	boarding.position = boarding_position
	_check(bool(zenith.get_zenith_audit_report().valid), "restoring the same marker returns green")

	var collision := zenith.get_node("PortMainGearFoot") as CollisionShape3D
	var box := collision.shape as BoxShape3D
	var box_size := box.size
	box.size.x += 0.4
	_check(_has_red_code(zenith, "collision_parameter_drift"), "box-size mutation produces structured collision_parameter_drift")
	box.size = box_size
	_check(bool(zenith.get_zenith_audit_report().valid), "restoring the same box resource returns green")
	var collision_rotation := collision.rotation_degrees
	collision.rotation_degrees.y += 0.5
	_check(_has_red_code(zenith, "collision_transform_drift"), "primitive rotation mutation produces structured collision_transform_drift")
	collision.rotation_degrees = collision_rotation
	_check(bool(zenith.get_zenith_audit_report().valid), "restoring the same primitive basis returns green")

	var cylinder_collision := zenith.get_node("PortMainGearStrut") as CollisionShape3D
	var cylinder := cylinder_collision.shape as CylinderShape3D
	var cylinder_radius := cylinder.radius
	cylinder.radius += 0.04
	_check(_has_red_code(zenith, "collision_parameter_drift"), "cylinder-radius mutation produces structured collision_parameter_drift")
	cylinder.radius = cylinder_radius
	_check(bool(zenith.get_zenith_audit_report().valid), "restoring the same cylinder resource returns green")

	var convex_collision := zenith.get_node("CenterWingRoot") as CollisionShape3D
	var convex := convex_collision.shape as ConvexPolygonShape3D
	var convex_points := convex.points
	var mutated_points := convex_points.duplicate()
	var mutated_point := mutated_points[0]
	mutated_point.x -= 0.05
	mutated_points.set(0, mutated_point)
	convex.points = mutated_points
	_check(_has_red_code(zenith, "collision_point_digest_drift"), "convex-point mutation produces structured collision_point_digest_drift")
	convex.points = convex_points
	_check(bool(zenith.get_zenith_audit_report().valid), "restoring the same convex resource and points returns green")

	var original_shape := collision.shape
	collision.shape = SphereShape3D.new()
	_check(_has_red_code(zenith, "collision_type_drift"), "resource-type mutation produces structured collision_type_drift")
	collision.shape = original_shape
	_check(bool(zenith.get_zenith_audit_report().valid), "restoring the exact mixed-shape resource identity returns green")
	collision.disabled = true
	_check(_has_red_code(zenith, "collision_transform_drift"), "disabled-shape mutation produces structured collision_transform_drift")
	collision.disabled = false
	_check(bool(zenith.get_zenith_audit_report().valid), "reenabling the same collision shape returns green")

	var presentation := zenith.get_zenith_authored_presentation()
	presentation.position = Vector3(0.1, 0.0, 0.0)
	var presentation_red := zenith.get_zenith_audit_report()
	_check(not bool(presentation_red.valid) and (presentation_red.error_codes as PackedStringArray).has("presentation_transform_drift") and (presentation_red.error_codes as PackedStringArray).has("authored_asset_red"), "presentation drift is red at wrapper and runtime boundaries")
	presentation.transform = Transform3D.IDENTITY
	_check(bool(zenith.get_zenith_audit_report().valid), "restoring presentation identity returns green")

	var ship_id := zenith.ship_id
	zenith.ship_id = &"zenith_mutated"
	_check(_has_red_code(zenith, "ship_identity_drift"), "ship ID mutation produces structured ship_identity_drift")
	zenith.ship_id = ship_id
	_check(bool(zenith.get_zenith_audit_report().valid), "restoring ship ID returns green")

	var plume := zenith.get_zenith_engine_plumes()[0]
	var plume_parent := plume.get_parent()
	plume_parent.remove_child(plume)
	var plume_red := zenith.get_zenith_audit_report()
	_check(not bool(plume_red.valid) and (plume_red.error_codes as PackedStringArray).has("authored_asset_red"), "detaching a protected plume produces structured authored_asset_red")
	plume_parent.add_child(plume)
	_check(bool(zenith.get_zenith_audit_report().valid), "readding the same protected plume restores authored audit")
	_check(bool(zenith.get_zenith_runtime_identity_report().stable), "all adversarial restores preserve original resources")

	var detached_report := zenith.get_zenith_audit_report()
	(detached_report.authored_asset as Dictionary)["asset_id"] = &"mutated_return_copy"
	(detached_report.runtime_identities as Dictionary)["stable"] = false
	_check(bool(zenith.get_zenith_audit_report().valid) and str(zenith.get_zenith_audit_report().authored_asset.asset_id) == "mudds.ship.zenith.b7_authored.v1", "public audit returns deeply detached dictionaries")


func _test_cleanup(zenith: ZenithInterceptor) -> void:
	Input.action_release("move_forward")
	Input.action_release("roll_right")
