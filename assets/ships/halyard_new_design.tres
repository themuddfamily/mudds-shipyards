display_name = "Halyard Crew Transport"
role_name = "Crew transport"
evidence_status = 2
evidence_references = PackedStringArray()
evidence_notes = "Original modern design. The Halyard is not a remake of any historical Keth ship, is not named after any name in the source ledger, and appears in no registered source. Nothing about it — name, silhouette, dimensions, colours, cabin, crew stations, systems, handling or berth — is a claim about the original game. It exists to fill a role the implemented fleet did not have: a long-legged pressurised crew carrier whose pilot can leave the seat and walk the hull under way. EvidenceStatus.NEW is deliberate; no evidence reference is attached, because there is no evidence to attach and inspiration is not authentication."
compatibility_tags = PackedStringArray("medium_craft", "crew_transport", "multi_crew")
