[gd_resource type="Resource" script_class="PlanetaryTerrainProfile" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/world/planetary_terrain_profile.gd" id="1_terrain"]

[resource]
script = ExtResource("1_terrain")
